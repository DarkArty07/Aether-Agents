{
  "name": "aether-agents-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && astro build",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "test": "node --test tests/content.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "7.3.1",
    "github-slugger": "2.0.0",
    "gsap": "3.15.0",
    "marked": "18.0.11",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/sanitize-html": "2.16.1",
    "linkedom": "0.18.13",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
