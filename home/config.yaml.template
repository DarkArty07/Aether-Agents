_config_version: 37
model:
  default: gpt-5.6-sol
  provider: custom:aether-router
  api_mode: codex_responses
  context_length: 272000
providers:
  aether-router:
    base_url: ${AETHER_ROUTER_BASE_URL}
    key_env: AETHER_ROUTER_API_KEY
    api_mode: codex_responses
toolsets:
  - terminal
  - file
  - web
  - browser
  - vision
  - memory
  - session_search
  - todo
  - tts
  - messaging
terminal:
  backend: local
web:
  backend: exa
browser:
  engine: auto
memory:
  enabled: true
sessions:
  enabled: true
display:
  skin: default
mcp_servers:
  context7:
    command: npx
    args:
      - -y
      - '@upstash/context7-mcp'
    enabled: true
