+
+    # Zero writes occurred
+    conn = kb.connect()
+    try:
+        assert (
+            conn.execute("SELECT COUNT(*) FROM task_comments").fetchone()[0]
+            == initial_comments
+        )
+        assert (
+            conn.execute("SELECT COUNT(*) FROM kanban_collaboration").fetchone()[0]
