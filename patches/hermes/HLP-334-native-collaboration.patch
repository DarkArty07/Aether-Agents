+                claimed = _kb.claim_collaboration_messages(
+                    conn,
+                    recipient_kind="origin",
+                    root_task_id=root_id,
+                    lease_seconds=60,
+                    limit=10,
+                )
+                if not claimed:
+                    continue
+                for c in claimed:
+                    enqueue_key = _kanban_collaboration_enqueue_key(
