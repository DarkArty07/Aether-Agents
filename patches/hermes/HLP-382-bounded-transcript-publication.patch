+# ── TS-382 bounded transcript publication ──────────────────────────────────
+# ``archive_and_compact`` publishes a rewritten transcript through hidden,
+# incrementally committed staging rows instead of one unbounded write
+# transaction (see hermes_state_compaction and TS-382-design.md D1-D7). These
+# names are the durable contract between the writer, the search surfaces that
+# must keep staging rows invisible (hermes_state_search), and the session
+# listing flags (hidden/archived).
+COMPACTION_STAGING_SESSION_SOURCE = "hermes-compaction-stage-v1"
+#: Reserved staging-session id prefix. MUST stay free of LIKE metacharacters
+#: (``_`` / ``%``): hermes_state_search matches it with a NOT LIKE predicate.
+COMPACTION_STAGING_SESSION_PREFIX = "hermes-compaction-stage-v1-"
+#: state_meta key prefix for the durable per-target publication ownership row;
+#: the exact target session id is appended as its SHA-256 hex digest.
+COMPACTION_PUBLICATION_MARKER_PREFIX = "hermes.compaction.publication.v1:"
+COMPACTION_PUBLICATION_VERSION = 1
+#: At most 128 rows or 512 KiB of prepared serialized values per transaction,
+#: whichever is reached first; the writer yields OUTSIDE the instance lock and
+#: SQLite's writer lock for this long between batches (D3).
+COMPACTION_PUBLICATION_BATCH_ROWS = 128
+COMPACTION_PUBLICATION_BATCH_BYTES = 512 * 1024
+COMPACTION_PUBLICATION_YIELD_S = 0.010
+#: Bounded catch-up/final-validation rounds per publication; exceeding them is
+#: an explicit conflict, never a spin or a timeout extension (D4).
+COMPACTION_PUBLICATION_MAX_ROUNDS = 8
+#: Publication lease duration — the existing compression-lease duration (D1).
+COMPACTION_PUBLICATION_LEASE_S = 300.0
+
+
+def _internal_session_exclusion(alias: str = "m") -> str:
+    """SQL predicate excluding internal transcript-publication staging rows.
+
+    ``archive_and_compact`` stages a rewritten transcript as hidden rows of an
+    internal session (``hermes-compaction-stage-v1-*``, ``hidden=1``,
+    ``archived=1``, ``active=0, compacted=0``). Flag-based visibility alone
+    hides them from the default paths, but the explicit ``include_inactive``
+    mode deliberately drops that filter — a staging session id must never
+    surface through ANY public read variant, so every query adds this clause
+    unconditionally (hermes_state_search's seven search paths,
+    ``get_messages``, ``get_messages_as_conversation``, ``get_messages_around``,
+    ``list_recent_user_messages``, ``find_pr_url_messages``, ``message_count``).
+    The prefix constant is LIKE-safe by construction (no ``_``/``%``).
+    """
+    return f"{alias}.session_id NOT LIKE '{COMPACTION_STAGING_SESSION_PREFIX}%'"
+
+
+def _internal_session_id_exclusion(alias: str = "s") -> str:
+    """SQL predicate excluding internal staging sessions themselves.
+
+    Sessions-table sibling of :func:`_internal_session_exclusion`: a staging
+    session must not appear in public listing, counting or by-id lookup
+    surfaces, including their explicit hidden/archived modes (TS-382 D2).
+    """
+    return f"{alias}.id NOT LIKE '{COMPACTION_STAGING_SESSION_PREFIX}%'"
+
