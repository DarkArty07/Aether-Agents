+            event
+            for event in kb.list_events(conn, controller)
+            if event.kind == "flow_attention_requeued"
+        ]
+    finally:
+        conn.close()
+
+
+def test_unblock_without_attention_preserves_parent_gating(tmp_path, monkeypatch):
