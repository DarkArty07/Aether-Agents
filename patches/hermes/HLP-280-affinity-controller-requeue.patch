@@ -0,0 +1,657 @@
+"""HLP-280 regression coverage for affinity controller liveness."""
+
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import projects_db
+
+
+def _project(tmp_path):
+    with projects_db.connect_closing() as project_conn:
+        return projects_db.create_project(
+            project_conn,
+            name=f"Project {tmp_path.name}",
+            primary_path=str(tmp_path),
+        )
+
+
+def _flow(conn, project_id, workspace, *, controller_status="running"):
+    root = kb.create_task(
+        conn,
+        title="root",
+        assignee="supervisor",
+        project_id=project_id,
+        session_id="origin-session",
+        workspace_kind="dir",
+        workspace_path=str(workspace),
+        session_affinity={"flow_id": "flow-280", "terminal": False},
+    )
+    assert kb.claim_task(conn, root) is not None
+    assert kb.complete_task(conn, root)
+    unit = kb.create_task(
+        conn,
+        title="unit",
+        assignee="implementer",
+        project_id=project_id,
+        parents=(root,),
+        session_id="origin-session",
+        workspace_kind="dir",
+        workspace_path=str(workspace),
+    )
+    controller = kb.create_task(
+        conn,
+        title="controller",
+        assignee="supervisor",
+        project_id=project_id,
+        parents=(root, unit),
+        session_id="origin-session",
+        workspace_kind="dir",
+        workspace_path=str(workspace),
+        session_affinity={"flow_id": "flow-280", "terminal": True},
+        initial_status=controller_status,
+    )
+    return unit, controller
+
+
+def _attention_events(conn, task_id):
+    return [
+        event
+        for event in kb.list_events(conn, task_id)
+        if event.kind == "flow_attention"
+    ]
+
+
+def test_external_unblock_makes_pending_controller_claimable(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    project_id = _project(tmp_path)
+    conn = kb.connect()
+    try:
+        unit, controller = _flow(
+            conn, project_id, tmp_path, controller_status="blocked"
+        )
+        assert kb.claim_task(conn, unit) is not None
+        assert kb.block_task(conn, unit, reason="recover", kind="capability")
+        assert len(_attention_events(conn, controller)) == 1
+        controller_task = kb.get_task(conn, controller)
+        assert controller_task is not None and controller_task.status == "blocked"
+        assert kb.recompute_ready(conn) == 0
+
+        assert kb.unblock_task(conn, controller)
+
+        controller_task = kb.get_task(conn, controller)
+        assert controller_task is not None and controller_task.status == "ready"
+        assert kb.claim_task(conn, controller) is not None
+        assert (
+            len([
+                event
+                for event in kb.list_events(conn, controller)
+                if event.kind == "flow_attention_requeued"
+            ])
+            == 1
+        )
+    finally:
+        conn.close()
+
+
+def test_stale_flow_attention_does_not_bypass_unblock_parent_gating(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    project_id = _project(tmp_path)
+    conn = kb.connect()
+    try:
+        unit, controller = _flow(
+            conn, project_id, tmp_path, controller_status="blocked"
+        )
+        assert kb.claim_task(conn, unit) is not None
+        assert kb.block_task(conn, unit, reason="recover", kind="capability")
+        conn.execute(
+            "UPDATE tasks SET session_affinity = ? WHERE id = ?",
+            ('{"flow_id":"other-flow","terminal":true}', controller),
+        )
+        conn.commit()
+
+        assert kb.unblock_task(conn, controller)
+
+        controller_task = kb.get_task(conn, controller)
+        assert controller_task is not None and controller_task.status == "todo"
+        assert not [
+            event
+            for event in kb.list_events(conn, controller)
+            if event.kind == "flow_attention_requeued"
+        ]
+    finally:
+        conn.close()
+
+
+def test_stale_flow_attention_cannot_bypass_claim_parent_gating(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    project_id = _project(tmp_path)
+    conn = kb.connect()
+    try:
+        unit, controller = _flow(
+            conn, project_id, tmp_path, controller_status="blocked"
+        )
+        assert kb.claim_task(conn, unit) is not None
+        assert kb.block_task(conn, unit, reason="recover", kind="capability")
+        conn.execute(
+            "UPDATE tasks SET session_affinity = ?, status = 'ready' WHERE id = ?",
+            ('{"flow_id":"other-flow","terminal":true}', controller),
+        )
+        conn.commit()
+
+        assert kb.claim_task(conn, controller) is None
+
+        controller_task = kb.get_task(conn, controller)
+        assert controller_task is not None and controller_task.status == "todo"
+        assert [
+            event
+            for event in kb.list_events(conn, controller)
+            if event.kind == "claim_rejected"
+        ]
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize(
+    ("column", "value"),
+    (
+        ("session_id", "other-session"),
+        ("session_affinity", "{malformed"),
+    ),
+)
+def test_invalid_pending_controller_boundaries_do_not_bypass_unblock(
+    tmp_path, monkeypatch, column, value
+):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    project_id = _project(tmp_path)
+    conn = kb.connect()
+    try:
+        unit, controller = _flow(
+            conn, project_id, tmp_path, controller_status="blocked"
+        )
+        assert kb.claim_task(conn, unit) is not None
+        assert kb.block_task(conn, unit, reason="recover", kind="capability")
+        conn.execute(f"UPDATE tasks SET {column} = ? WHERE id = ?", (value, controller))
+        conn.commit()
+
+        assert kb.unblock_task(conn, controller)
+
+        controller_task = kb.get_task(conn, controller)
+        assert controller_task is not None and controller_task.status == "todo"
+    finally:
+        conn.close()
+
