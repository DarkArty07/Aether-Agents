+def test_rediscovery_preserves_deliberately_blocked_controller(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    project_id = _project(tmp_path)
+    conn = kb.connect()
