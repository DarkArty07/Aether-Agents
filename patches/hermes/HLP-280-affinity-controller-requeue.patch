+def test_terminal_failure_of_non_affinity_unit_wakes_controller(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    project_id = _project(tmp_path)
+    conn = kb.connect()
+    try:
+        unit, controller = _flow(conn, project_id, tmp_path)
+
+        assert kb._record_task_failure(
+            conn,
+            unit,
+            "worker crashed",
+            outcome="crashed",
+            failure_limit=1,
+        )
+
+        unit_task = kb.get_task(conn, unit)
+        controller_task = kb.get_task(conn, controller)
