{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-agents.local/schemas/observation-segment-manifest.schema.json",
  "title": "Aether Observation Closed-Segment Archive Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "segment_id",
    "project_id",
    "producer_epoch",
    "first_seq",
    "last_seq",
    "event_count",
    "line_count",
    "source_name",
    "archive_name",
    "uncompressed_length",
    "uncompressed_sha256",
    "compressed_length",
    "compressed_sha256",
    "event_schema_versions",
    "collector_versions",
    "runtime_fingerprints",
    "compression"
  ],
  "properties": {
    "schema_version": {
      "const": "aether.observation.segment-manifest.v1"
    },
    "segment_id": {
      "type": "string",
      "pattern": "^seg_[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "producer_epoch": {
      "type": "string",
      "pattern": "^prd_[a-f0-9]{32}$"
    },
    "first_seq": {
      "type": "integer",
      "minimum": 0
    },
    "last_seq": {
      "type": "integer",
      "minimum": 0
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "line_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_name": {
      "type": "string",
      "pattern": "^prd_[a-f0-9]{32}\\.[0-9]+-[0-9]+\\.jsonl$",
      "maxLength": 128
    },
    "archive_name": {
      "type": "string",
      "pattern": "^prd_[a-f0-9]{32}\\.[0-9]+-[0-9]+\\.jsonl\\.gz$",
      "maxLength": 131
    },
    "uncompressed_length": {
      "type": "integer",
      "minimum": 1
    },
    "uncompressed_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compressed_length": {
      "type": "integer",
      "minimum": 1
    },
    "compressed_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^aether\\.observation\\.event\\.v[1-9][0-9]*$"
      }
    },
    "collector_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+:-]*$"
      }
    },
    "runtime_fingerprints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "level",
        "mtime",
        "header_filename",
        "header_comment",
        "os_byte"
      ],
      "properties": {
        "algorithm": {
          "const": "gzip"
        },
        "level": {
          "const": 9
        },
        "mtime": {
          "const": 0
        },
        "header_filename": {
          "type": "null"
        },
        "header_comment": {
          "type": "null"
        },
        "os_byte": {
          "const": 255
        }
      }
    }
  }
}
