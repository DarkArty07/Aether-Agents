{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DarkArty07/Aether-Agents/blob/main/specs/001-aether-v1-productization/contracts/release-lock.schema.json",
  "title": "Aether release dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "aether", "hermes", "profile_bundle"],
  "properties": {
    "schema_version": {"const": 4},
    "aether": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "package_version", "distribution", "git_tag", "git_commit", "python_requires", "observer", "wheel_sha256", "observer_requirements_sha256", "observation_compatibility"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "package_version": {"type": "string", "minLength": 1},
        "distribution": {"const": "aether-agents"},
        "git_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "git_commit": {"$ref": "#/$defs/git_commit"},
        "python_requires": {"const": ">=3.11,<3.14"},
        "observer": {"$ref": "#/$defs/observer_entry_point"},
        "wheel_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Trusted SHA-256 of the Aether wheel authorized for the declared Git commit, verified before inspection or installation."
        },
        "observer_requirements_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the hash-bound observer runtime dependency closure packaged in the candidate wheel; distinct from the final wheel digest."
        },
        "observation_compatibility": {"$ref": "#/$defs/observation_compatibility"}
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_mode",
        "repository",
        "branch",
        "version",
        "commit",
        "python_requires",
        "source_tree_sha256",
        "artifacts"
      ],
      "properties": {
        "source_mode": {
          "const": "maintained_fork",
          "description": "The Aether 1.0 RC consumes the maintained fork as reviewed source. The retired `upstream` and `transitional_fork` modes, which replayed residual `.patch` files onto a fixed public baseline, are refused for new preparation."
        },
        "repository": {"const": "https://github.com/DarkArty07/aether-hermes"},
        "branch": {"const": "aether-main"},
        "version": {"type": "string", "minLength": 1},
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
          "description": "Optional exact tag on the selected commit. When declared it must dereference to `commit` in the verified checkout; the maintained fork does not tag every candidate revision."
        },
        "commit": {"$ref": "#/$defs/git_commit"},
        "python_requires": {"type": "string", "minLength": 1},
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the canonical path-and-file-byte projection of the exact Git commit materialized locally (never a Git blob): rows `(posix-relative-path, sha256(file bytes))` collected in `os.walk` DFS order with per-level sorted names, `__pycache__` excluded, symlinks and non-regular files refused, serialized as `json.dumps(rows, separators=(\",\", \":\"), ensure_ascii=True)` and hashed once. The lifecycle validator re-derives this value from the materialized commit and refuses any mismatch; it is distinct from every externally published artifact digest and from the editable-install projection."
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"},
          "contains": {
            "properties": {"kind": {"const": "source"}},
            "required": ["kind"]
          },
          "minContains": 1
        }
      }
    },
    "profile_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "roles"],
      "properties": {
        "version": {"const": "2"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "roles": {
          "type": "array",
          "prefixItems": [
            {"const": "morfeo"},
            {"const": "supervisor"},
            {"const": "implementer"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observer_entry_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_name", "group", "target"],
      "properties": {
        "plugin_name": {"const": "aether-contract-observer"},
        "group": {"const": "hermes_agent.plugins"},
        "target": {"const": "aether_agents.observation.capture.hermes_plugin"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "filename", "url", "sha256", "provenance_url"],
      "properties": {
        "kind": {"enum": ["source", "wheel", "sdist"]},
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "provenance_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "observation_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_write_version",
        "event_read_versions",
        "summary_write_version",
        "summary_read_versions",
        "segment_manifest_write_version",
        "segment_manifest_read_versions",
        "projection_schema_version"
      ],
      "properties": {
        "event_write_version": {
          "const": "aether.observation.event.v1"
        },
        "event_read_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^aether\\.observation\\.event\\.v[1-9][0-9]*$"
          },
          "contains": {"const": "aether.observation.event.v1"}
        },
        "summary_write_version": {
          "const": "aether.observation.summary.v1"
        },
        "summary_read_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^aether\\.observation\\.summary\\.v[1-9][0-9]*$"
          },
          "contains": {"const": "aether.observation.summary.v1"}
        },
        "segment_manifest_write_version": {
          "const": "aether.observation.segment-manifest.v1"
        },
        "segment_manifest_read_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^aether\\.observation\\.segment-manifest\\.v[1-9][0-9]*$"
          },
          "contains": {"const": "aether.observation.segment-manifest.v1"}
        },
        "projection_schema_version": {
          "type": "string",
          "pattern": "^aether\\.observation\\.projection\\.v[1-9][0-9]*$"
        }
      }
    }
  }
}
