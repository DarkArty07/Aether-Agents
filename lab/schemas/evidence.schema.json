{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.invalid/lab/evidence.schema.json",
  "title": "Aether laboratory compact evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "mode"],
  "properties": {
    "schema_version": {"const": "aether.lab.evidence.v1"},
    "kind": {"type": "string", "enum": ["run", "matrix", "observation", "persistent"]},
    "status": {"type": "string", "enum": ["PREPARED", "PASS", "FAIL", "CAPABILITY_WALL"]},
    "mode": {"type": "string", "enum": ["prepare-only", "live-oneshot", "live-persistent"]},
    "suite": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "scenario": {"type": "string", "pattern": "^e2e-[0-9]{2}$"},
    "expected_route": {"type": "string", "enum": ["direct", "pipeline", "safety", "recovery"]},
    "observed_route": {"type": "string", "enum": ["direct", "pipeline", "safety", "recovery"]},
    "route_ok": {"type": "boolean"},
    "acceptance_passed": {"type": "boolean"},
    "baseline_acceptance_passed": {"type": "boolean"},
    "owner_interventions": {"type": "integer", "minimum": 0},
    "expected_owner_interventions": {"type": "integer", "minimum": 0},
    "owner_interventions_ok": {"type": "boolean"},
    "harness_continuations": {"type": "integer", "minimum": 0},
    "guard_denials_ok": {"type": "boolean"},
    "observed_protected_edge_violation": {"type": "boolean"},
    "aether_self_modification": {"type": "boolean"},
    "fault_recovered": {"type": "boolean"},
    "missing_required_paths": {"type": "array", "items": {"type": "string"}},
    "present_forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "board_task_count": {"type": "integer", "minimum": 0},
    "board_settled": {"type": "boolean"},
    "board_successful": {"type": "boolean"},
    "persistent_autonomous_wake_qualified": {"type": "boolean"},
    "parallel": {"type": "integer", "minimum": 1, "maximum": 2},
    "parallel_peak": {"type": "integer", "minimum": 1, "maximum": 2},
    "isolation_verified": {"type": "boolean"},
    "matrix_index": {"type": "integer", "minimum": 1},
    "runs": {"type": "array", "items": {"type": "object"}},
    "rolling_reliability_gate": {"type": "object"},
    "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "live_run_count": {"type": "integer", "minimum": 0},
    "window_size": {"type": "integer", "minimum": 0},
    "window_passes": {"type": "integer", "minimum": 0},
    "rolling_reliability_counted": {"type": "boolean"},
    "registered_tool": {"const": "aether_observe"},
    "calls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "success", "bytes", "limit"],
        "properties": {
          "action": {"type": "string", "enum": ["status", "changes", "diagnose"]},
          "success": {"type": "boolean"},
          "bytes": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "enum": [2048, 4096]}
        }
      }
    },
    "content_redacted": {"const": true},
    "native_same_session_wake": {"type": "boolean"},
    "durable_report": {"type": "boolean"},
    "owner_messages": {"type": "integer", "minimum": 0},
    "same_session": {"type": "boolean"},
    "continuation_source": {"type": "string", "enum": ["native", "harness", "one-shot"]}
  }
}
