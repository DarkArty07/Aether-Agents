{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.invalid/lab/evidence.schema.json",
  "title": "Aether laboratory compact evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "mode"],
  "properties": {
    "schema_version": {"const": "aether.lab.evidence.v1"},
    "kind": {"type": "string", "enum": ["run", "matrix", "observation", "persistent"]},
    "status": {"type": "string", "enum": ["PREPARED", "PASS", "FAIL", "CAPABILITY_WALL"]},
    "mode": {"type": "string", "enum": ["prepare-only", "live-oneshot", "live-persistent"]},
    "suite": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
    "scenario": {"type": "string", "pattern": "^e2e-[0-9]{2}$"},
    "expected_route": {"type": "string", "enum": ["direct", "pipeline", "safety", "recovery"]},
    "observed_route": {"type": "string", "enum": ["direct", "pipeline", "safety", "recovery"]},
    "route_ok": {"type": "boolean"},
    "acceptance_passed": {"type": "boolean"},
    "baseline_acceptance_passed": {"type": "boolean"},
    "owner_interventions": {"type": "integer", "minimum": 0},
    "expected_owner_interventions": {"type": "integer", "minimum": 0},
    "owner_interventions_ok": {"type": "boolean"},
    "harness_continuations": {"type": "integer", "minimum": 0},
    "guard_denials_ok": {"type": "boolean"},
    "observed_protected_edge_violation": {"type": "boolean"},
    "aether_self_modification": {"type": "boolean"},
    "fault_recovered": {"type": "boolean"},
    "missing_required_paths": {"type": "array", "items": {"type": "string"}},
    "present_forbidden_paths": {"type": "array", "items": {"type": "string"}},
    "board_task_count": {"type": "integer", "minimum": 0},
    "board_settled": {"type": "boolean"},
    "board_successful": {"type": "boolean"},
    "persistent_autonomous_wake_qualified": {"type": "boolean"},
    "parallel": {"type": "integer", "minimum": 1, "maximum": 2},
    "parallel_peak": {"type": "integer", "minimum": 1, "maximum": 2},
    "isolation_verified": {"type": "boolean"},
    "matrix_index": {"type": "integer", "minimum": 1},
    "runs": {"type": "array", "items": {"type": "object"}},
    "rolling_reliability_gate": {"type": "object"},
    "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "live_run_count": {"type": "integer", "minimum": 0},
    "window_size": {"type": "integer", "minimum": 0},
    "window_passes": {"type": "integer", "minimum": 0},
    "rolling_reliability_counted": {"type": "boolean"},
    "registered_tool": {"const": "aether_observe"},
    "model": {"type": "string", "maxLength": 128},
    "provider": {"type": "string", "maxLength": 128},
    "api_calls": {"type": "integer", "minimum": 0},
    "provider_operationally_exercised": {"type": "boolean"},
    "aether_observe_calls": {"type": "integer", "minimum": 0},
    "forbidden_fallback_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "file", "raw_logs_events"],
      "properties": {
        "terminal": {"type": "integer", "minimum": 0},
        "file": {"type": "integer", "minimum": 0},
        "raw_logs_events": {"type": "integer", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "survivors"],
      "properties": {
        "completed": {"type": "boolean"},
        "survivors": {"type": "integer", "minimum": 0}
      }
    },
    "private_runtime_retained": {"type": "boolean"},
    "calls": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "success", "bytes", "limit"],
        "properties": {
          "action": {"type": "string", "enum": ["status", "changes", "diagnose"]},
          "success": {"type": "boolean"},
          "bytes": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "enum": [2048, 4096]}
        }
      }
    },
    "content_redacted": {"const": true},
    "native_same_session_wake": {"type": "boolean"},
    "durable_report": {"type": "boolean"},
    "owner_messages": {"type": "integer", "minimum": 0},
    "same_session": {"type": "boolean"},
    "continuation_source": {"type": "string", "enum": ["native", "harness", "one-shot"]},
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "first_supervisor_session_id",
        "resumed_supervisor_session_id",
        "implementer_session_ids",
        "other_flow_session_id",
        "other_project_session_id",
        "other_role_session_id",
        "first_process_exit",
        "resumed_process_exit",
        "resume_invoked",
        "workspace_pinned",
        "prior_tool_evidence_observed",
        "reconstructed_input_sent",
        "stale_generation_rejected",
        "implementer_fresh",
        "internal_milestone_route",
        "terminal_route",
        "input_route",
        "revision_route",
        "flow_binding_ok",
        "project_binding_ok",
        "role_binding_ok",
        "other_flow_rejected",
        "other_project_rejected",
        "other_role_rejected",
        "native_control_lifecycle_observed",
        "review_integration_observed",
        "reclaim_succeeded",
        "session_reused",
        "controls_passed"
      ],
      "properties": {
        "flow_id": {"type": "string", "maxLength": 256},
        "first_supervisor_session_id": {"type": "string", "maxLength": 256},
        "resumed_supervisor_session_id": {"type": "string", "maxLength": 256},
        "implementer_session_ids": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "maxLength": 256}
        },
        "other_flow_session_id": {"type": "string", "maxLength": 256},
        "other_project_session_id": {"type": "string", "maxLength": 256},
        "other_role_session_id": {"type": "string", "maxLength": 256},
        "first_process_exit": {"type": "integer"},
        "resumed_process_exit": {"type": "integer"},
        "resume_invoked": {"type": "boolean"},
        "workspace_pinned": {"type": "boolean"},
        "prior_tool_evidence_observed": {"type": "boolean"},
        "reconstructed_input_sent": {"type": "boolean"},
        "stale_generation_rejected": {"type": "boolean"},
        "implementer_fresh": {"type": "boolean"},
        "internal_milestone_route": {"type": "string", "maxLength": 64},
        "terminal_route": {"type": "string", "maxLength": 64},
        "input_route": {"type": "string", "maxLength": 64},
        "revision_route": {"type": "string", "maxLength": 64},
        "flow_binding_ok": {"type": "boolean"},
        "project_binding_ok": {"type": "boolean"},
        "role_binding_ok": {"type": "boolean"},
        "other_flow_rejected": {"type": "boolean"},
        "other_project_rejected": {"type": "boolean"},
        "other_role_rejected": {"type": "boolean"},
        "native_control_lifecycle_observed": {"type": "boolean"},
        "review_integration_observed": {"type": "boolean"},
        "reclaim_succeeded": {"type": "boolean"},
        "session_reused": {"type": "boolean"},
        "controls_passed": {"type": "boolean"}
      }
    }
  }
}
